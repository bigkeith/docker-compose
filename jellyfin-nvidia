version: "3"
services:
  jellyfin:
    image: jellyfin/jellyfin
    container_name: jellyfin
    #user: 1000:1000
    #network_mode: host
    runtime: nvidia
    environment:
      - NVIDIA_VISIBLE_DEVICES=all
      - NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    volumes:
      - /mnt/media/jellyfin/config:/config
      - /mnt/media/jellyfin/cache:/cache
      - /mnt/media/sabnzbd/downloads/completed:/media
    ports:
      - 8096:8096
      - 8920:8920
    networks:
      - network1
    restart: unless-stopped
#define my network
networks:
   network1:
     name: proxymanager_default
     external: true
